# Workspace API key from Dashboard → Workspace → Settings → API Keys
AGENTIC_FLOW_API_KEY=

# EU (default): https://api.agenticflow.studio
# UAE: https://api.ae.agenticflow.studio
AGENTIC_FLOW_BASE_URL=https://api.agenticflow.studio

# AgenticFlow catch-webhook (or n8n) that sends request_a_call
# Also set this as a Supabase Edge Function secret.
FORM_WEBHOOK_URL=

# Only needed for local curl tests against the store RPCs.
# Lives in AF workspace variables + Edge Function secrets otherwise. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# inbound-brain model provider (Supabase Edge Function secrets, not local .env):
#   supabase secrets set BRAIN_API_KEY=sk-...
#   supabase secrets set BRAIN_MODEL=gpt-4o-mini        (optional)
#   supabase secrets set BRAIN_API_URL=https://...      (optional, OpenAI-compatible)

# Voice slice (Supabase Edge Function secrets, not local .env):
#   supabase secrets set VOICE_ASSISTANT_ID=...   # AF realtime assistant the dialer calls
#   supabase secrets set VOICE_HUB_SECRET=...     # HMAC secret shared with the assistant's server block
