{
  "name": "Send WA Template",
  "type": "SHARED",
  "summary": "Callable box: send the form-start WhatsApp template.",
  "description": "Code builds the Meta payload (no npm). HTTP POSTs it. The Code sandbox has no fetch and no require.",
