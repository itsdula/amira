        "displayName": "Callable Flow",
        "type": "PIECE_TRIGGER",
        "nextAction": {
          "name": "build_template",
          "skip": false,
          "type": "CODE",
          "valid": true,
          "displayName": "Build template payload",
          "settings": {
            "input": {
              "phone": "{{trigger['output']['data']['phone']}}",
              "name": "{{trigger['output']['data']['name']}}",
              "vehicle": "{{trigger['output']['data']['vehicle']}}",
              "language": "{{trigger['output']['data']['language']}}",
              "apiKey": "{{variables['AgenticFlow_API_KEY']}}"
            },
            "sourceCode": {
              "packageJson": "{}",
              "code": "export const code = async (inputs) => {\n  const ar = inputs.language === \"ar\";\n  return {\n    url: \"https://api.ae.agenticflow.studio/messaging/messages\",\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      \"X-Api-Key\": inputs.apiKey,\n    },\n    queryParams: {},\n    authType: \"NONE\",\n    body_type: \"json\",\n    body: {\n      channelId: \"160e6c61-174a-4de1-b338-ce2e27666c37\",\n      to: inputs.phone,\n      type: \"template\",\n      template: {\n        name: \"callback_request_confirm\",\n        language: ar ? \"ar\" : \"en_US\",\n        components: [\n          {\n            type: \"body\",\n            parameters: [\n              { type: \"text\", text: String(inputs.name ?? \"\") },\n              { type: \"text\", text: String(inputs.vehicle ?? \"\") },\n            ],\n          },\n        ],\n      },\n    },\n    use_proxy: false,\n    followRedirects: false,\n    response_is_binary: false,\n    failureMode: \"continue_none\",\n  };\n};\n"
            },
            "errorHandlingOptions": {
              "retryOnFailure": { "value": false },
              "continueOnFailure": { "value": false }
            }
          },
          "nextAction": {
            "name": "send_template",
            "skip": false,
            "type": "PIECE",
            "valid": true,
            "displayName": "Send WhatsApp template",
            "settings": {
              "pieceName": "@activepieces/piece-http",
              "actionName": "send_request",
              "pieceVersion": "0.11.10",
              "sampleData": {},
              "input": {
                "url": "https://api.ae.agenticflow.studio/messaging/messages",
                "method": "POST",
                "authType": "NONE",
                "body_type": "json",
                "use_proxy": false,
                "followRedirects": false,
                "response_is_binary": false,
                "failureMode": "continue_none",
                "headers": {
                  "Content-Type": "application/json",
                  "X-Api-Key": "{{variables['AgenticFlow_API_KEY']}}"
                },
                "body": {
                  "data": "{{build_template['output']}}"
                },
                "authFields": {},
                "queryParams": {},
                "proxy_settings": {}
              },
              "propertySettings": {
